; GDExtension descriptor for the Nightfall streaming native library.
;
; Without this file Godot never loads libnightfall-stream, so
; ClassDB.class_exists("NightfallStream") is false and main.gd:758 aborts
; startup with "[FATAL] NightfallStream GDExtension failed to load".
;
; entry_symbol matches register_types.cpp:55 (nightfall_stream_init).
; Library paths match the CMake deploy target: CMakeLists.txt:165 copies the
; built library to addons/nightfall-stream/bin/<platform>/, named
; lib<LIBNAME><GODOTCPP_SUFFIX>.so where the suffix is
; .<platform>.template_<debug|release>.<arch> (CMakeLists.txt:64-76).
;
; NOTE: a template_release export needs a release-built .so; the default
; `cmake --preset android` produces the template_debug variant. See BUILD.md
; "Release Build" for the CMAKE_BUILD_TYPE=Release + llvm-strip step.

[configuration]

entry_symbol = "nightfall_stream_init"
compatibility_minimum = "4.2"

[libraries]

android.debug.arm64 = "res://addons/nightfall-stream/bin/android/libnightfall-stream.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/nightfall-stream/bin/android/libnightfall-stream.android.template_release.arm64.so"

linux.debug.x86_64 = "res://addons/nightfall-stream/bin/linux/libnightfall-stream.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/nightfall-stream/bin/linux/libnightfall-stream.linux.template_release.x86_64.so"
